# ---- Base de Datos PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=gastos_db

# ---- Servidor Backend ----
PORT=3000

# ---- Autenticación JWT ----
JWT_SECRET=tu_clave_secreta_super_segura_para_jwt
JWT_EXPIRES_IN=8h

# ---- Google Identity Services (OAuth 2.0) ----
# Obtén tu Client ID en Google Cloud Console:
# 1. Ve a https://console.cloud.google.com/apis/credentials
# 2. Crea credenciales de tipo 'ID de cliente de OAuth 2.0' (Aplicación web)
# 3. Agrega a 'Orígenes autorizados de JavaScript': http://localhost:4200 y http://localhost:3000
# 4. Pega aquí el Client ID (ejemplo: 123456789-abcdef.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
